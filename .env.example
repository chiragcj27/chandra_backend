PORT=
MONGODB_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used to derive deterministic (but not name-guessable) client passwords.
# Must be kept secret and should be unique per deployment.
PASSWORD_SEED=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional — uploads / banners / categories images (S3). Omit to run API without file storage.
# AWS_REGION=
# S3_BUCKET=
# S3_PUBLIC_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
